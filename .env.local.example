# Copy to .env.local for local dev, or set these in Vercel for production.

NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=

DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

KEEPA_API_KEY=
KEEPA_DOMAIN_ID=1

OPENAI_API_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 32 — variation attribution blend weights. Combine the two signals
# used to distribute group-level sales across variation siblings.
# Defaults: 0.4 reviews + 0.6 Buy Box win frequency. Buy Box is weighted
# higher because winner churn reflects actual recent purchase activity,
# while review counts can be legacy or amplified by parent-level review
# sharing. The two need not sum to 1 — the resolver re-normalizes.
VARIATION_REVIEW_WEIGHT=0.4
VARIATION_BUYBOX_WEIGHT=0.6

# Phase 33 — Brand Owner Resolver web-search provider.
# Default priority: openai (uses OPENAI_API_KEY above) → perplexity → brave.
# Set WEB_SEARCH_PROVIDER to pin a specific provider when multiple keys exist.
# WEB_SEARCH_PROVIDER=openai
# PERPLEXITY_API_KEY=
# BRAVE_SEARCH_API_KEY=
